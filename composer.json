{
    "name": "makershub/guestbook",
    "type": "project",
    "description": "Framework X guestbook",
    "require": {
        "php": ">=8.1",
        "clue/framework-x": "^0.17",
        "react/mysql": "^0.7@dev",
        "react/async": "^4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
